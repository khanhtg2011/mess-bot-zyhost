# Prefix lệnh (mặc định: /)
PREFIX=/

# Đăng nhập Facebook (dùng khi chưa có appstate.json hoặc cookie hết hạn)
FB_EMAIL=
FB_PASSWORD=
FB_2FA_SECRET=

# Meta Model API (muse-spark-1.3)
MODEL_API_KEY=

# API Key AI (Hỗ trợ nhiều key cách nhau dấu phẩy để tự xoay vòng khi hết quota)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-2.5-flash

# API dự phòng miễn phí / OpenAI-compatible (tùy chọn)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-exp:free

# Tự động tải video khi có người thả link TikTok/Reels/Shorts vào nhóm (true/false)
AUTO_DOWNLOAD=true

# Địa chỉ Haven & Server để lệnh /sv kiểm tra trạng thái
HAVEN_URL=https://haven.khanhs.io.vn

# Danh sách Facebook UID Admin (cách nhau bởi dấu phẩy)
ADMIN_UIDS=
